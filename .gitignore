# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example

# ignore AI folders
.omc
.claude

# Lighthouse CI report output (uploaded as a CI artifact, never committed)
.lighthouseci

# Bundle-provenance analysis output (ANALYZE_BUNDLE=1); analysis input, never committed
.bundle-analysis

# Playwright e2e output (uploaded as a CI artifact, never committed)
test-results
playwright-report
blob-report
.playwright

# Governed Lighthouse (D20-25): the HTTP/2 frontend's certificate is generated per run into the OS
# temp directory and disposed on exit, so nothing should ever land here. These entries exist so that
# a future change which writes the key into the repo is caught by git rather than by a leak.
*.pem
lh-h2-cert-*/
.lighthouse-tmp/
