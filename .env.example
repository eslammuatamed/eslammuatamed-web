# Copy to .env and adjust per environment. Every value is validated at boot (doc 16 §1).
# The production domain is deferred (docs D23-8): all hosts live here, never in code.

# Canonical origin of the public site (SEO: canonicals, hreflang, sitemap — doc 22)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of the NestJS API, including the version prefix (doc 10 §2)
NUXT_PUBLIC_API_BASE=http://localhost:3001/api/v1
